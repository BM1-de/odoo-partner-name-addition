<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form (partner_name_addition)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//h1[field[@name='name']]" position="after">
                <label for="name_addition" class="d-md-none" />
                <div class="d-flex align-items-baseline w-md-50 gap-2">
                    <!-- keeps the field in line with the rows below, which start
                         with an icon -->
                    <i
                        class="oi d-none d-md-inline-flex invisible"
                        data-icon="business"
                    />
                    <field
                        name="name_addition"
                        placeholder="Name addition, e.g. trade name or department"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
